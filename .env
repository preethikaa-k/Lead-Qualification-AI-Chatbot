# Default local configuration using Ollama Qwen 2.5 3B (Zero GPU needed)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434

# Secondary Fallback: Cloud Google Gemini (Automatic failover if local Ollama is offline)
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.0-flash
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=

# Local embeddings using sentence-transformers (Zero API key needed, CPU fast)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

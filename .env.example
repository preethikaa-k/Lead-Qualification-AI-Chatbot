# ==============================================================================
# ASHCOMBE & ROWE ESTATES - ENVIRONMENT CONFIGURATION (.env.example)
# Never commit real API keys to version control. Fill in your keys below.
# ==============================================================================

# Primary LLM Provider (Required by specification)
# Options: ollama (local CPU/GPU), gemini, groq, openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=http://localhost:11434

# Secondary / High-Availability Fallback LLM Provider (Failover Circuit)
# If local Ollama Qwen is offline or uncontactable, requests fail over to Gemini
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-2.0-flash
FALLBACK_LLM_API_KEY=your_gemini_api_key_here
FALLBACK_LLM_BASE_URL=

# Embedding Provider Configuration (Required by specification for FAQ RAG)
# Options: local (sentence-transformers all-MiniLM-L6-v2), gemini, openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=your_embedding_api_key_here

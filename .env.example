# ==============================================================================
# ASHCOMBE & ROWE ESTATES - ACTIVE ENVIRONMENT CONFIGURATION
# Primary LLM: Google Gemini Cloud (<300ms ultra-low latency)
# Fallback LLM: Local Qwen 2.5 3B via Ollama (Automatic failover if Gemini is offline)
# ==============================================================================

# Primary LLM Provider: Google Gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=

# Secondary Fallback: Local Qwen 2.5 (Automatic failover if Gemini limits hit)
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_LLM_MODEL=qwen2.5:3b
FALLBACK_LLM_API_KEY=ollama
FALLBACK_LLM_BASE_URL=http://localhost:11434

# Production RAG: Open-Source BGE Embeddings, Overlapping Chunking, and Cross-Encoder Re-ranking
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2
RAG_VECTOR_STORE=chroma
RAG_CHUNK_SIZE=280
RAG_CHUNK_OVERLAP=50

# Enterprise Observability & Tracing (Langfuse)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local Short-Term Memory (Default: Pure Local In-Memory, Strictly Last 5 Turns, Zero External Daemon)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400
SHORT_TERM_MEMORY_WINDOW=5
